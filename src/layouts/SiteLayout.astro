---
import '../styles/global.css';
const {
  title = 'FlameWM — Your desktop, distilled.',
  description = 'FlameWM is an independent Rust desktop and window manager for Linux. Familiar by design. Lightweight at heart.',
  page = 'home',
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const url = (relative) => `${base}${relative.replace(/^\//, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0c10" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32x32.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FlameWM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('assets/brand/flamewm-real-screenshot-preview.webp'), Astro.site || Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="header" id="top" data-header>
      <div class="container header-inner">
        <a href={url('')} class="identity" aria-label="FlameWM — Home">
          <img class="brand-wordmark" src={url('assets/brand/flamewm-navbar.webp')} alt="FlameWM" width="198" height="62" decoding="async" />
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href={url('')} aria-current={page === 'home' ? 'page' : undefined}>Overview</a>
          <a href={url('features/')} aria-current={page === 'features' ? 'page' : undefined}>Features</a>
          <a href={url('about/')} aria-current={page === 'about' ? 'page' : undefined}>About</a>
          <a href={url('') + '#benchmarks'}>RAM usage</a>
          <a href={url('try/')}>Interactive demo <span aria-hidden="true">↗</span></a>
        </nav>
        <div class="nav-actions">
          <a href="https://github.com/ArkFlame/flamewm" class="github-link" target="_blank" rel="noopener noreferrer" aria-label="FlameWM on GitHub">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8A11.2 11.2 0 0 0 8.46 22.63c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.34-3.79-1.34-.51-1.3-1.25-1.65-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15A10.7 10.7 0 0 1 12 6.08c.95 0 1.9.13 2.8.38 2.14-1.45 3.08-1.15 3.08-1.15.62 1.55.23 2.69.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.04.76 2.1v3.12c0 .3.2.65.78.54A11.2 11.2 0 0 0 12 .8Z" /></svg>
          </a>
          <a class="button button-small button-accent nav-primary" href={url('try/')}>Explore FlameWM <span aria-hidden="true">↗</span></a>
          <button type="button" class="menu-toggle" data-menu-toggle aria-label="Open navigation" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span><span></span></button>
        </div>
      </div>
      <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" data-mobile-menu hidden>
        <a href={url('')}>Overview</a>
        <a href={url('features/')}>Features</a>
        <a href={url('about/')}>About</a>
        <a href={url('') + '#benchmarks'}>RAM usage</a>
        <a href={url('try/')}>Interactive demo</a>
        <a href="https://github.com/ArkFlame/flamewm" target="_blank" rel="noopener noreferrer">Source on GitHub ↗</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="footer">
      <div class="container footer-top">
        <div>
          <a class="identity footer-identity" href={url('')}><img class="brand-wordmark" src={url('assets/brand/flamewm-navbar.webp')} alt="FlameWM" width="198" height="62" loading="lazy" decoding="async" /></a>
          <p>A lighter way to feel at home on Linux.</p>
        </div>
        <div class="footer-links"><div><strong>Explore</strong><a href={url('features/')}>Features</a><a href={url('try/')}>Interactive demo</a><a href={url('') + '#benchmarks'}>RAM comparison</a><a href={url('about/')}>About</a></div><div><strong>Project</strong><a href="https://github.com/ArkFlame/flamewm" target="_blank" rel="noopener noreferrer">Source code ↗</a><a href="https://github.com/ArkFlame/flamewm/issues" target="_blank" rel="noopener noreferrer">Issues ↗</a><a href="https://paypal.me/LinsaFTW" target="_blank" rel="noopener noreferrer">Support development ↗</a></div></div>
      </div>
      <div class="container footer-bottom"><span>© <span data-year>2026</span> ArkFlame Studios. Built for Linux.</span><span>Independent Rust project · In active development</span></div>
    </footer>
    <script src={url('assets/js/site.js')} is:inline></script>
  </body>
</html>
